{
  "name": "waxseal",
  "version": "0.1.0",
  "description": "Detached Ed25519 Merkle seal for WACZ web archives. Sign an archive once, verify it offline anywhere; include membership proofs per file.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "bin": {
    "waxseal": "src/cli.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srivtx/waxseal.git"
  },
  "homepage": "https://github.com/srivtx/waxseal",
  "bugs": {
    "url": "https://github.com/srivtx/waxseal/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "wacz",
    "web-archive",
    "merkle",
    "ed25519",
    "inclusion-proof",
    "signature",
    "seal",
    "provenance",
    "typescript",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun -e \"import { defaultWacz } from './src/fixtures.ts'; await Bun.write('fixtures/default.wacz', defaultWacz());\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
